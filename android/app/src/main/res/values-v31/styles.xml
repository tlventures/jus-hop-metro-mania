<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch theme using the platform Splash Screen API.
         The animated spinner icon is drawn by the OS immediately on tap,
         before the Flutter engine initialises. -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <!-- DeviceDefault carries a system ActionBar (app label) — disable it,
             or "MetroSafar" shows as a native title bar above the Flutter UI. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_spinner</item>
        <item name="android:windowSplashScreenAnimationDuration">1200</item>
        <!-- After the splash, hand off to the normal Flutter window theme -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_background</item>
    </style>

    <!-- Normal theme applied once the splash exits. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
