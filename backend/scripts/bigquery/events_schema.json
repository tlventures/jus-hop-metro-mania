  { "name": "ingested_at",       "type": "TIMESTAMP", "mode": "REQUIRED",  "description": "Server ingest timestamp" },
  { "name": "city_id",           "type": "STRING",    "mode": "NULLABLE",  "description": "Active city at time of event" },
  { "name": "locale",            "type": "STRING",    "mode": "NULLABLE",  "description": "Device locale" },
  { "name": "platform",          "type": "STRING",    "mode": "NULLABLE",  "description": "ios | android" },
  { "name": "os_version",        "type": "STRING",    "mode": "NULLABLE",  "description": "OS version string" },
  { "name": "app_version",       "type": "STRING",    "mode": "NULLABLE",  "description": "App build version" },
  { "name": "device_model",      "type": "STRING",    "mode": "NULLABLE",  "description": "Device model name" },
