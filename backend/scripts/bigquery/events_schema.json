  { "name": "session_id",        "type": "STRING",    "mode": "NULLABLE",  "description": "Session UUID" },
  { "name": "session_start_ts",  "type": "TIMESTAMP", "mode": "NULLABLE",  "description": "Session start timestamp" },
  { "name": "trip_mode_active",  "type": "BOOLEAN",   "mode": "NULLABLE",  "description": "Whether user was in metro trip mode" },
